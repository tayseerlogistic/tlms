rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tayseerlogistic@gmail.com' ||
        request.auth.token.email == 'admin@tls.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOperator() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserRole() == 'operator' || getUserRole() == 'dispatcher'));
    }

    function isEditor() {
      return isAdmin() || isOperator() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'editor');
    }

    function isDispatcher() {
      return isOperator();
    }

    function isCashier() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'cashier');
    }

    function isStaff() {
      return isAdmin() || isEditor() || isOperator() || isCashier();
    }

    // Admin authorization table
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && (
        // Self-creation with default role or admin assigning
        request.auth.uid == userId || isAdmin()
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    function activeDriverAssignment() {
      let data = request.resource.data;
      return !('assignedDriverId' in data) || data.assignedDriverId == null || data.assignedDriverId == ''
        || (existsAfter(/databases/$(database)/documents/drivers/$(data.assignedDriverId))
          && getAfter(/databases/$(database)/documents/drivers/$(data.assignedDriverId)).data.active != false);
    }

    // Trucks collection
    match /trucks/{truckId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isValidId(truckId) && request.resource.data.plate is string && request.resource.data.plate.size() <= 32 && activeDriverAssignment();
      allow update: if isStaff() && isValidId(truckId) && activeDriverAssignment();
      allow delete: if isAdmin() && isValidId(truckId);
    }

    // Equipment collection
    match /equipment/{equipId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isValidId(equipId) && request.resource.data.equipNo is string && request.resource.data.equipNo.size() <= 32;
      allow update: if isStaff() && isValidId(equipId);
      allow delete: if isAdmin() && isValidId(equipId);
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isValidId(driverId) && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow update: if isStaff() && isValidId(driverId);
      allow delete: if isAdmin() && isValidId(driverId);
    }

    // Daily Manifests
    match /manifests/{manifestId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() && isValidId(manifestId);
      allow delete: if isAdmin() && isValidId(manifestId);
    }

    // Timetable Schedules
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() && isValidId(scheduleId);
      allow delete: if isAdmin() && isValidId(scheduleId);
    }

    // Cashbook Transactions
    match /cashbook/{txId} {
      allow read: if isSignedIn() && (isStaff() || (resource.data.employee == request.auth.token.email));
      allow create: if (isAdmin() || isCashier()) && isValidId(txId) && request.resource.data.amount is number && request.resource.data.account is string;
      allow update: if (isAdmin() || isCashier()) && isValidId(txId);
      allow delete: if isAdmin() && isValidId(txId);
    }

    // Cashbook Accounts
    // The client uses cash_accounts; keep the legacy path readable for existing deployments.
    match /cash_accounts/{accId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || isCashier()) && isValidId(accId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.opening is number
        && request.resource.data.opening >= 0;
      allow delete: if isAdmin() && isValidId(accId);
    }
    match /cashbook_accounts/{accId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(accId);
    }

    // Separate Cashbook employee directory; this never modifies fleet driver records.
    match /cash_employees/{employeeId} {
      allow read: if isSignedIn() && isStaff();
      allow create: if (isAdmin() || isCashier()) && isValidId(employeeId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update: if (isAdmin() || isCashier()) && isValidId(employeeId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if (isAdmin() || isCashier()) && isValidId(employeeId);
    }

    // Only one canonical distance/meter document per immutable truck ID and day.
    function validKm(recordId) {
      let r = request.resource.data;
      return r.truckId is string && r.date is string
        && r.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && recordId == r.truckId + '_' + r.date
        && exists(/databases/$(database)/documents/trucks/$(r.truckId))
        && r.distanceKm is number && r.distanceKm >= 0 && r.distanceKm < 1000000000
        && (r.odometerKm == null || (r.odometerKm is number && r.odometerKm >= 0 && r.odometerKm < 1000000000000))
        && r.km == r.distanceKm && r.odometer == r.odometerKm;
    }
    function canWriteKm() {
      return isStaff() || (isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserRole() == 'driver'
        && get(/databases/$(database)/documents/trucks/$(request.resource.data.truckId)).data.assignedDriverId
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.driverId);
    }
    match /km_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if canWriteKm() && isValidId(recordId) && validKm(recordId);
      allow update: if canWriteKm() && isValidId(recordId) && validKm(recordId)
        && request.resource.data.truckId == resource.data.truckId
        && request.resource.data.date == resource.data.date;
      allow delete: if isAdmin() && isValidId(recordId);
    }
    match /import_batches/{batchId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expectedRecordCount is int && request.resource.data.expectedRecordCount >= 0;
      allow update: if isStaff() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.expectedRecordCount == resource.data.expectedRecordCount
        && request.resource.data.persistedRecordCount >= 0
        && request.resource.data.persistedRecordCount <= resource.data.expectedRecordCount;
      allow delete: if false;
    }
    match /commodities/{id} { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /stores/{id} { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /data_quality/{id} { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /app_state/{id} {
      allow read: if isSignedIn();
      allow write: if (id == 'branding' && isAdmin()) || (id == 'learnedRules' && isStaff());
    }

    // Diesel logs
    match /diesel_logs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() && isValidId(logId) && request.resource.data.liters is number;
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Audit logs (Immutable)
    match /audit/{auditId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && isValidId(auditId);
      allow update, delete: if false;
    }
  }
}
